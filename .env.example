# Copy to .env for machine-local overrides. .env is ignored by Git and is
# loaded automatically by the Python bootstrap. Existing shell variables win.
# Room 与历史 Provider 默认值在 config/*.toml；Phase 4 在配置 Key 后连接 Realtime。
# 密钥只放 .env，不进入 config、源码或文档。
ANNIE_HOST=0.0.0.0
ANNIE_PORT=8780
ANNIE_DATABASE=var/runtime.db
ANNIE_LOG_LEVEL=INFO

# 具身智能展厅：内网 HTTP 直接访问，无需登录令牌和逐次授权。
# 旧 ANNIE_EXHIBIT_OPERATOR_TOKEN / ANNIE_EXHIBIT_VIEWER_TOKEN 不再参与访问判定。
# ANNIE_EXHIBIT_LIVEKIT_URL=wss://livekit.example.com
# ANNIE_EXHIBIT_LIVEKIT_API_KEY=
# ANNIE_EXHIBIT_LIVEKIT_API_SECRET=
# ANNIE_EXHIBIT_LIVEKIT_SOURCE=camera-a
# ANNIE_EXHIBIT_LIVEKIT_ROOM_ANNIE_A=robot-test
# ANNIE_EXHIBIT_LIVEKIT_ROOM_ANNIE_B=robot-test-b
# LiveKit 同时支持 ws:// 内网地址和 wss:// 地址，无需额外允许开关。

# 阿里百炼 / DashScope
DASHSCOPE_API_KEY=
# ANNIE_MEMORY_ENABLED=1             # 需 DASHSCOPE_API_KEY；关闭仅停自动抽取与记忆工具
# ANNIE_MEMORY_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# ANNIE_ACTIONS_ENABLED=1             # 仅真机确认后开启，默认关闭
# ANNIE_IDLE_ENABLED=1                # Phase 8C：需真实TTS及结构化人物视觉证据；默认关闭
# ANNIE_IDLE_MODEL=qwen3.8-max-0902    # 仅8C独立规划，不替换Realtime
# ANNIE_IDLE_TRUSTED_ROOM=1            # 明确确认无第三者可听到聊天上下文后方可开启8C发声
# ANNIE_CONTINUATION_ENABLED=1         # 私人房间内的短时续聊；还需当前会话主动选择「积极追问」
# ANNIE_CONTINUATION_SECONDS=15        # 真机扬声器播完后等待秒数；同一用户回合最多尝试一次
# ANNIE_ACTION_ALLOWLIST=agree_micro_nod,look_left,look_right,fast_double_blink,surprise,smirk,proud,skeptical,shy
# 如果现有 .env / 系统环境已设置 ACTION_ALLOWLIST，需自行添加五个新 ID 才能放行。
# Phase 4B: real Room playback is opt-in until device/AEC/stop receipts are verified.
# ANNIE_TTS_ENABLED=1
# ANNIE_TTS_EXPRESSION_ENABLED=0  # 试验：Realtime附带表达标签；默认不改变TTS音频主链
ANNIE_TTS_MIXED_MODE_ENABLED=0    # 内测：首句双向、后续句一次完整文本单独流式合成；需先开启上项
# ANNIE_TTS_URL=wss://dashscope.aliyuncs.com/api-ws/v1/inference
# ANNIE_VISEME_ENABLED=1
# ANNIE_VISEME_PYTHON=/path/to/sidecars/tts_viseme/.venv311/bin/python
# Optional Beijing endpoint default; for Singapore or dedicated workspace use
# the corresponding /api-ws/v1/realtime wss URL (without a model query).
# 官方推荐业务空间专属域名（性能/稳定性更好），把 {WorkspaceId} 换成自己的业务空间 ID：
# ANNIE_REALTIME_URL=wss://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/api-ws/v1/realtime
# ANNIE_TTS_URL=wss://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/api-ws/v1/inference
# ANNIE_REALTIME_URL=wss://dashscope.aliyuncs.com/api-ws/v1/realtime
# 覆盖 config/providers.toml [realtime].model；仅限 qwen-audio-*-realtime-flash/plus。
# ANNIE_REALTIME_MODEL=qwen-audio-3.1-realtime-plus
# 决策模型：多人对话时判断“是不是对机器人说的”，并由它挑选自发表情（配置地址即启用）。
# ANNIE_DECISION_URL=https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/compatible-mode/v1/systemone
# 自建 d3-NVFP4 决策模型（config/providers.toml [decision] prefer = "d3" 时优先用，不可用自动回退阿里）。
# 地址填 http(s)://<主机>:<端口>；token 只放本机 .env，绝不入库。
# ANNIE_D3_URL=http://<host>:<port>
# ANNIE_D3_TOKEN=
# ANNIE_ADDRESSEE_ENABLED=1
# ANNIE_AUTO_EXPRESSION_ENABLED=1
# 对话结束后 3 分钟内的旁听（仅唤醒模式；有声音才上云 ASR；只存内存、不入库）。默认关闭。
# ANNIE_AMBIENT_LISTEN_ENABLED=1

# sherpa-onnx 云端中文关键词检测（默认禁用；启用后需要解压官方预训练模型）。
# 下载官方中文Zipformer 2025-12-20模型到var/models/，关键词文件在config/。
# 依赖由uv.lock安装；16kHz/20ms PCM到每头独立流式KWS，休眠不发Qwen。
# ANNIE_WAKEWORD_ENABLED=1
# ANNIE_WAKEWORD_MODEL=var/models/sherpa-onnx-kws-zipformer-zh-en-3M-2025-12-20
# ANNIE_WAKEWORD_KEYWORDS=config/小安妮唤醒词.tokens.txt
# ANNIE_WAKEWORD_THRESHOLD=0.35
# 云端 WebRTC AEC：Windows 网页只上送原始 PCM；仅 A 机器人服务端处理。
# 同时要求嵌入式扬声器经 reb_voice/main 上报真实 speaker 播放游标。
# ANNIE_CLOUD_AEC_ENABLED=1
# ANNIE_CLOUD_AEC_ROBOTS=annie-a
# ANNIE_CLOUD_AEC_SYNC_OFFSET_MS=80   # 服务端参考时间粗对齐；现场校准
# ANNIE_CLOUD_AEC_DELAY_MS=0          # WebRTC APM 处理剩余设备延迟；现场校准
# 仅隔离测试用宽松方案（高Boosting + #0.04等低阈值，可能显著增加误唤醒）：
# ANNIE_WAKEWORD_KEYWORDS=config/小安妮唤醒词_宽松实验.tokens.txt

# 高德天气
AMAP_WEATHER_API_KEY=

# 本地 MiniCPM / LM Studio 默认不校验 Key，保留非空占位即可。
MINICPM_API_KEY=local

# 全局声纹：设置里用麦克风登记姓名。模型缺失时对话照常，注册接口会说明原因。
# 原始录音不入库，只保留声纹向量。阈值是工程默认，真人误识仍需现场校准。
# ANNIE_SPEAKER_ENABLED=1
# ANNIE_SPEAKER_MODEL=var/models/3dspeaker_speech_campplus_sv_zh-cn_16k-common.onnx
# ANNIE_SPEAKER_THRESHOLD=0.50
# ANNIE_SPEAKER_MARGIN=0.08
# QSR语言/声学情绪观察旁路：默认关闭；只消费已通过唤醒准入的16kHz PCM。
# 开关关闭保留Chat/机器人显式偏好；不保存原始音频或声纹。
ANNIE_ACOUSTIC_SIDECAR_ENABLED=0
# 固定qwen3-asr-flash-realtime；空值采用现有DashScope /api-ws/v1/realtime默认端点。
ANNIE_ACOUSTIC_SIDECAR_URL=
