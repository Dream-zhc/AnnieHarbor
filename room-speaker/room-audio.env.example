# 本机配置，复制为 room-audio.env 后修改；改完执行 sh annie-audio.sh start 生效。
# Room 服务地址和房间
SPEAKER_HOST=192.168.1.47
SPEAKER_PORT=8090
SPEAKER_ROOM=roomv2
# 1=开麦克风，0=不开
ROOM_MIC=1
# 1=开扬声器，0=不开
ROOM_SPEAKER=1
# 声卡名称片段或编号，留空用系统默认；sh annie-audio.sh devices 查看。名称有空格要加引号
SPEAKER_DEVICE=
MIC_DEVICE=
# 多声道麦克风取第几路，从 0 开始
MIC_CHANNEL=0
# 机器人头：同一房间有两块板时设置，后启动的接管，先启动的自动停止。
# 标识只用字母、数字、下划线；显示名有空格要加引号。留空不参与接管。
ROBOT_HEAD=
ROBOT_HEAD_NAME=
