# Copy to .env for machine-local overrides. .env is ignored by Git and is
# loaded automatically by the Python bootstrap. Existing shell variables win.
# Provider/Room 默认值在 config/*.toml；Phase 1 仍不会连接真实外部能力。
# 密钥只放 .env，不进入 config、源码或文档。
ANNIE_HOST=127.0.0.1
ANNIE_PORT=8780
ANNIE_DATABASE=var/runtime.db
ANNIE_LOG_LEVEL=INFO

# 阿里百炼 / DashScope
DASHSCOPE_API_KEY=

# 高德天气
AMAP_WEATHER_API_KEY=

# 本地 MiniCPM / LM Studio 默认不校验 Key，保留非空占位即可。
MINICPM_API_KEY=local
