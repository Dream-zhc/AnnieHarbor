# 必填：阿里云百炼 API Key（北京地域）
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxx

# 可选：业务空间专属域名前缀，例如 llm-xxxxxxxx。
# Audio Realtime/LLM 会优先使用专属域名；TTS 默认 auto，失败会回退公共端点。
ALIYUN_WORKSPACE_ID=

# 模型，可随时替换
QWEN_AUDIO_MODEL=qwen-audio-3.0-realtime-flash
LLM_MODEL=qwen3.6-flash
TTS_MODEL=qwen-audio-3.0-tts-flash
TTS_VOICE=longanhuan_v3.6

# TTS 端点策略：auto / workspace / public
# auto：先专属域名，再公共域名；推荐保留。
TTS_ENDPOINT_MODE=auto
# 高级覆盖。正常不要填写；路径必须是 /api-ws/v1/inference，不能多写尾随斜杠。
TTS_WS_URL=
# 启动时用 run-task + cancel 验证端点、模型、音色和参数，建议开启。
TTS_PREFLIGHT=true

# 主模型人设。Demo 默认回答短一些，便于测延迟和打断。
SYSTEM_PROMPT=你叫小安妮，是一个自然、有情感但不夸张的中文语音伙伴。回答口语化、直接、简短，通常1到3句话。不要使用Markdown，不要输出括号动作描写。

# Qwen-Audio 只承担 ASR + smart_turn。内部回答限制为一个句号并静默丢弃；
# 允许 response 正常完成，以避免线上“180秒没有完成 response”关闭会话。
AUDIO_SENSOR_PROMPT=你只作为实时听觉与轮次判断协处理器。若被触发生成回答，只输出一个句号。
AUDIO_MAX_HISTORY_TURNS=6
AUDIO_SENSOR_HEARTBEAT_SEC=120
AUDIO_SENSOR_RECONNECT_BUFFER_MS=1600
AUDIO_SENSOR_RECONNECT_MAX_SEC=8

# TTS 表达控制。若当前账号/端点拒绝 instruction，Demo 会自动降级基础参数并记录日志。
TTS_INSTRUCTION=自然、亲近、温柔，带轻微愉快感，语速自然偏快，停顿短，不要播音腔，不要夸张。
TTS_RATE=1.0
TTS_PITCH=1.0
TTS_VOLUME=50

# 级联与打断参数
FIRST_TTS_CHARS=10
NEXT_TTS_CHARS=28
HARD_STOP_WORDS=停,等一下,别说了,闭嘴,打住,先别说,换个问题
MEANINGFUL_STABLE_CHARS=3

# 服务
HOST=127.0.0.1
PORT=8765
LOG_LEVEL=INFO

# v1.7 Barge-in 策略
# qwen（推荐）：本地 dBFS/SNR 只展示；Qwen speech_started 后暂停并完整
# 保留音频，turn_invalid/ambient 时原位续播，有效 ASR 前缀时才硬切。
# cloud-hard：Qwen speech_started 立即清空取消，最快，但“嗯/啊”也可能截断。
# hybrid / semantic / hard / duck：仅用于和旧本地规则做 A/B。
BARGE_MODE=qwen
BARGE_ABSOLUTE_DBFS=-46
BARGE_MIN_SNR_DB=7
BARGE_CANDIDATE_FRAMES=2
BARGE_LOCAL_TIMEOUT_MS=700
BARGE_LOCAL_ARM_DELAY_MS=180
BARGE_LOCAL_RELEASE_FRAMES=4
BARGE_HOLD_WATCHDOG_MS=950
BARGE_FADE_OUT_MS=3
BARGE_FADE_IN_MS=12
# 正常播放及 Qwen 暂停期间都完整保存音频；30 秒仅为灾难保护。
PLAYBACK_MAX_QUEUE_MS=30000
# 首播抖动缓冲：越大越稳，但会增加相同毫秒数左右的起播延迟。
PLAYBACK_PREBUFFER_MS=180
# 播放中断粮后，积累该时长再恢复，避免反复碎裂。
PLAYBACK_REBUFFER_MS=100
# 仅旧本地推测模式使用；qwen 模式不裁剪暂停期间音频。
BARGE_HOLD_QUEUE_MS=240
# 仅旧本地推测模式使用。
BARGE_FALSE_CANDIDATE_LIMIT=2
BARGE_FALSE_CANDIDATE_WINDOW_MS=8000
BARGE_LOCAL_SUPPRESS_MS=15000
