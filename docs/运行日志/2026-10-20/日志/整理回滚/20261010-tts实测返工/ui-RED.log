                  <strong>
                    {recall.length
                      ? `${recall.length} 次，${recall.some(item=>!item.valid)?'含失败 / 拒绝请求，':''}返回 ${memoryEvidence.length} 条证据`
                      : '无调用记录（不等于检索失败）'}
