# 复制为 room-audio.env 后修改。start.sh 和开机自启服务都读这个文件。
# Room Server 与房间：A=roomv2，B=roomv3。一个 Room 只留一个麦克风、一个扬声器。
SPEAKER_HOST=192.168.1.47
SPEAKER_PORT=8090
SPEAKER_ROOM=roomv2
# 1=同时开麦克风（机器人板上用）；0=只开扬声器
ROOM_MIC=1
# 0=不开扬声器（只开麦克风）
ROOM_SPEAKER=1
# 设备编号或名称片段，留空用系统默认。先运行 sh start.sh --list-devices 查看。
# 名称里有空格要加引号，例如 MIC_DEVICE="USB Composite"。
SPEAKER_DEVICE=
MIC_DEVICE=
# 多声道麦克风阵列取第几路，从 0 开始
MIC_CHANNEL=0
# 机器人头。同一 Room 有两块板（如大头和 obj 娃娃）时设置：后启动的接管，先启动的自动停止并退出，
# 工作台和大屏显示当前是哪个头。留空则不参与接管（例如 Windows 上临时开的扬声器）。
# 标识只用字母、数字、下划线；显示名有空格要加引号。
ROBOT_HEAD=
ROBOT_HEAD_NAME=
