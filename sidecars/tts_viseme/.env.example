# 当前listener只消费已有PCM，不调用LLM/TTS API，无Provider密钥。
# parse_args和顶层常量先于load_dotenv；这些设置应在启动前导出，URL也可用CLI显式传入。
TTS_VISEME_SAM_WS_URL=ws://192.168.1.47:8090/robot/roomv2/reb_sam
TTS_VISEME_TTS_WS_URL=ws://192.168.1.47:8090/robot/roomv2/reb_tts
TTS_VISEME_ALIGNER_MODEL=Qwen/Qwen3-ForcedAligner-0.6B
TTS_VISEME_ALIGNER_BACKEND=auto
TTS_VISEME_SINGLETON_PORT=37659
# 填入未来V2真实观测HTTP地址后才导出；当前没有V2 HTTP服务。
TTS_VISEME_OBSERVE_URL=
