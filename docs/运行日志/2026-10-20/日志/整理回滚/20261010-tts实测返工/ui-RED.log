                {([
                  ['起声 → ASR 最终','speech_started_ms','asr_final_ms','speech_to_asr_final_ms'],
                  ['语音结束 → ASR 最终','speech_stopped_ms','asr_final_ms','endpoint_to_asr_final_ms'],
